# The open-pr-agent container: the Rust binaries, git, and the opencode engine.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.rust -t open-pr-agent .
#
# The engine is opencode v2 (`opencode run`), driven by the `pr_agent`
# binary; the read-only `pr-reviewer` agent is packaged into every worktree
# the engine prepares, so no global opencode config is required.
#
# By default opencode downloads from the official release files
# (https://opencode.ai/files/bin/<version>/...). Behind a corporate mirror,
# override the URL (and checksum) with build args:
#   docker build -f docker/Dockerfile.rust \
#     --build-arg OPENCODE_TARBALL_URL=https://mirror.example.com/opencode-linux-x64.tar.gz \
#     --build-arg OPENCODE_SHA256=<sha256> -t open-pr-agent .

# ---- build: the Rust workspace -------------------------------------------------
FROM rust:1.90-bookworm AS build
WORKDIR /build
COPY rust/ rust/
# Keep Cargo state on the builder and stage the binaries outside the cache mount.
RUN --mount=type=cache,id=open-pr-agent-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=open-pr-agent-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=open-pr-agent-cargo-target,target=/build/rust/target,sharing=locked \
    cargo build --release --manifest-path rust/Cargo.toml --bin pr_agent --bin pr_agent_server \
    && install -Dm755 rust/target/release/pr_agent /out/pr_agent \
    && install -Dm755 rust/target/release/pr_agent_server /out/pr_agent_server

# ---- build: the optional review skill -----------------------------------------
FROM node:22-bookworm-slim AS skill
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Pin both the installer and the upstream skill snapshot. Install Markdown
# and its license, leaving upstream scripts outside the runtime image.
RUN --mount=type=secret,id=corpca \
    set -eu; \
    if [ -f /run/secrets/corpca ]; then \
        export CURL_CA_BUNDLE=/run/secrets/corpca NODE_EXTRA_CA_CERTS=/run/secrets/corpca; \
    fi; \
    temp="$(mktemp -d)"; \
    mkdir -p "$temp/source" "$temp/install" /opt/pr-agent/skills; \
    curl -fsSL https://codeload.github.com/awesome-skills/code-review-skill/tar.gz/4850184dfd7765ea7b3c5c4e9b6cf8e0815ee7cb -o "$temp/skill.tar.gz"; \
    echo "2e28cef6bd4ad9d35e3414e4a17c779dd2694f361f5b1ae1e5f3951f5372803a  $temp/skill.tar.gz" | sha256sum -c -; \
    tar -xzf "$temp/skill.tar.gz" -C "$temp/source" --strip-components=1 \
        --wildcards '*/SKILL.md' '*/LICENSE' '*/reference/*.md'; \
    cd "$temp/install"; \
    DISABLE_TELEMETRY=1 npm_config_cache="$temp/npm" npx --yes skills@1.7.3 add "$temp/source" \
        --skill code-review-skill --agent opencode --copy --yes; \
    mv .agents/skills/code-review-skill /opt/pr-agent/skills/; \
    cp "$temp/source/LICENSE" /opt/pr-agent/skills/code-review-skill/LICENSE; \
    cd /; \
    rm -rf "$temp"

# ---- runtime: git + opencode + the binaries -------------------------------------
FROM debian:bookworm-slim
# Pin the engine release: the official files URL and its sha256.
ARG OPENCODE_VERSION=2.3.0
ARG OPENCODE_TARBALL_URL=
ARG OPENCODE_SHA256=fc0f81522aceeabac47693d88389efa2bc517ce74c2c38fd6967819fcc6e4d3b
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
# The download may sit behind a TLS-intercepting proxy: pass the proxy CA as
# a build secret (docker build --secret id=corpca,src=<ca-bundle>). Without
# the secret the image's own CA store must already trust the endpoint.
RUN --mount=type=secret,id=corpca \
    set -eux; \
    url="${OPENCODE_TARBALL_URL:-https://opencode.ai/files/bin/${OPENCODE_VERSION}/opencode-linux-x64.tar.gz}"; \
    if [ -f /run/secrets/corpca ]; then \
        export SSL_CERT_FILE=/run/secrets/corpca; \
        NODE_EXTRA_CA_CERTS=/run/secrets/corpca; \
    fi; \
    curl -fsSL "$url" -o /tmp/opencode.tar.gz; \
    echo "${OPENCODE_SHA256}  /tmp/opencode.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/opencode.tar.gz -C /usr/local/bin opencode; \
    chmod +x /usr/local/bin/opencode; \
    opencode --version; \
    rm -f /tmp/opencode.tar.gz

COPY --from=skill /opt/pr-agent/skills /opt/pr-agent/skills
COPY --from=build /out/pr_agent /usr/local/bin/pr_agent
COPY --from=build /out/pr_agent_server /usr/local/bin/pr_agent_server
COPY rust/app/settings/opencode_defaults.json /root/.config/opencode/opencode.json
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Pull-request review mode; the server overrides this in its own deployments.
ENV PR_AGENT_MODE=action
ENTRYPOINT ["/entrypoint.sh"]
