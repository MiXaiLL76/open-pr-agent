# The PR-Agent container: the Rust binaries, git, and the opencode engine.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.rust -t pr-agent .
# or
#   make build
#
# The engine is opencode v2 (`opencode run`), driven by the `pr_agent`
# binary; the read-only `pr-reviewer` agent is packaged into every worktree
# the engine prepares, so no global opencode config is required.
#
# By default opencode downloads from the official release files
# (https://opencode.ai/files/bin/<version>/...). Behind a corporate mirror,
# override the URL (and checksum) with build args:
#   docker build -f docker/Dockerfile.rust \
#     --build-arg OPENCODE_TARBALL_URL=https://mirror.example.com/opencode-linux-x64.tar.gz \
#     --build-arg OPENCODE_SHA256=<sha256> -t pr-agent .

# ---- build: the Rust workspace -------------------------------------------------
FROM rust:1.90-bookworm AS build
WORKDIR /build
COPY rust/ rust/
RUN cargo build --release --manifest-path rust/Cargo.toml --bin pr_agent --bin pr_agent_server

# ---- runtime: git + node + opencode + the binaries -----------------------------
FROM node:22-bookworm-slim
# Pin the engine release: the official files URL and its sha256.
ARG OPENCODE_VERSION=2.3.0
ARG OPENCODE_TARBALL_URL=
ARG OPENCODE_SHA256=fc0f81522aceeabac47693d88389efa2bc517ce74c2c38fd6967819fcc6e4d3b
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
# The download may sit behind a TLS-intercepting proxy: pass the proxy CA as
# a build secret (docker build --secret id=corpca,src=<ca-bundle>). Without
# the secret the image's own CA store must already trust the endpoint.
RUN --mount=type=secret,id=corpca \
    set -eux; \
    url="${OPENCODE_TARBALL_URL:-https://opencode.ai/files/bin/${OPENCODE_VERSION}/opencode-linux-x64.tar.gz}"; \
    if [ -f /run/secrets/corpca ]; then \
        export SSL_CERT_FILE=/run/secrets/corpca; \
        NODE_EXTRA_CA_CERTS=/run/secrets/corpca; \
    fi; \
    curl -fsSL "$url" -o /tmp/opencode.tar.gz; \
    echo "${OPENCODE_SHA256}  /tmp/opencode.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/opencode.tar.gz -C /usr/local/bin opencode; \
    chmod +x /usr/local/bin/opencode; \
    opencode --version; \
    rm -f /tmp/opencode.tar.gz

COPY --from=build /build/rust/target/release/pr_agent /usr/local/bin/pr_agent
COPY --from=build /build/rust/target/release/pr_agent_server /usr/local/bin/pr_agent_server
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Pull-request review mode; the server overrides this in its own deployments.
ENV PR_AGENT_MODE=action
ENTRYPOINT ["/entrypoint.sh"]
