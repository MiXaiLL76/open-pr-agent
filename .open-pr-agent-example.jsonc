{
  // Engine config for pr-agent reviews of this project. It is merged into the
  // generated opencode config when PR_AGENT_LLM_BASE_URL / PR_AGENT_LLM_API_KEY /
  // PR_AGENT_MODEL are set. Anything opencode understands may live here:
  // MCP servers, agent overrides, env for MCP processes...
  //
  // Do NOT define providers/models for the pr-agent-llm provider id — pr-agent
  // injects those from the environment and overwrites this id. Other provider
  // ids are left as-is but are not used by reviews.
  //
  // Without the PR_AGENT_LLM_* env, this file is ignored and the engine uses
  // its own discovery (global ~/.config/opencode, project .opencode/).
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    // Example: give the reviewer read access to a docs server
    // "docs": { "type": "local", "command": ["uvx", "mcp-server-fetch"] }
  },

  "agents": {
    // OpenCode v2 uses agents and ordered permissions rules.
    // Example: tighten the packaged reviewer policy for this project
    // "pr-reviewer": {
    //   "model": "pr-agent-llm/<model-from-env>",
    //   "permissions": [
    //     { "action": "edit", "resource": "*", "effect": "deny" },
    //     { "action": "shell", "resource": "*", "effect": "deny" }
    //   ]
    // }
  }
}
