{
  // Copy to .open-pr-agent/opencode.jsonc and set
  // PR_AGENT_ALLOW_PROJECT_OPENCODE_CONFIG=true to load this file.
  // Only use operator-trusted config: it may start MCP processes or plugins.
  // The pr-agent-llm provider is injected from PR_AGENT_LLM_* when configured.
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    // Example: give the reviewer read access to a docs server
    // "docs": { "type": "local", "command": ["uvx", "mcp-server-fetch"] }
  },

  "agents": {
    // OpenCode v2 uses agents and ordered permissions rules.
    // Example: tighten the packaged reviewer policy for this project
    // "pr-reviewer": {
    //   "model": "pr-agent-llm/<model-from-env>",
    //   "permissions": [
    //     { "action": "edit", "resource": "*", "effect": "deny" },
    //     { "action": "shell", "resource": "*", "effect": "deny" }
    //   ]
    // }
  }
}
